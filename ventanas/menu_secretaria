from PySide6.QtWidgets import (
    QFrame,
    QGridLayout,
    QHBoxLayout,
    QLabel,
    QPushButton,
    QStyle,
    QVBoxLayout,
)
from PySide6.QtCore import Qt, QSize, Signal

from ventanas.ventana import VentanaBase, Config


class VentanaMenu(VentanaBase):
    accion_seleccionada = Signal(str)

    def __init__(self, nombre_usuario=""):
        super().__init__("SIGEA - Menú principal", 1100, 680)
        self.nombre_usuario = nombre_usuario
        self.crear_interfaz()
        self.centrar_ventana()

    def crear_interfaz(self):
        principal = QVBoxLayout(self)
        principal.setContentsMargins(28, 22, 28, 28)
        principal.setSpacing(22)

        encabezado = QHBoxLayout()
        encabezado.setSpacing(12)

        icono_inicio = QLabel()
        icono_inicio.setPixmap(
            self.style()
            .standardIcon(QStyle.SP_DirHomeIcon)
            .pixmap(QSize(42, 42))
        )
        encabezado.addWidget(icono_inicio)

        titulo = self.crear_label_titulo(
            "MENÚ PRINCIPAL",
            tamano=30,
            color="#FFFFFF",
        )
        encabezado.addWidget(titulo)
        encabezado.addStretch()

        boton_salir = self.crear_boton_salida(
            "Salir",
            self.close,
            ancho=110,
            alto=44,
        )
        encabezado.addWidget(boton_salir)

        principal.addLayout(encabezado)

        if self.nombre_usuario:
            bienvenida = QLabel(f"Sesión iniciada: {self.nombre_usuario}")
            bienvenida.setStyleSheet(
                "color: #E8F0FF; font-size: 12px; background: transparent;"
            )
            principal.addWidget(bienvenida)

        tarjetas = QGridLayout()
        tarjetas.setSpacing(20)

        tarjetas.addWidget(
            self.crear_tarjeta_menu(
                "ALUMNOS",
                QStyle.SP_FileDialogContentsView,
                [
                    ("Consultas", ["Consultar alumnos"]),
                    ("Inscripciones", [
                        "Alta de alumno",
                        "Baja de alumno",
                        "Modificaciones",
                    ]),
                    ("Reinscripciones", [
                        "Alta de alumno",
                        "Baja de alumno",
                        "Modificaciones",
                    ]),
                    ("Constancias", ["Solicitudes de constancias"]),
                ],
            ),
            0, 0,
        )

        tarjetas.addWidget(
            self.crear_tarjeta_menu(
                "DOCENTES",
                QStyle.SP_ComputerIcon,
                [
                    ("Gestión de docentes", [
                        "Alta de docente",
                        "Baja de docente",
                        "Modificaciones",
                        "Consultas",
                    ]),
                ],
            ),
            0, 1,
        )

        tarjetas.addWidget(
            self.crear_tarjeta_menu(
                "ESTADÍSTICAS",
                QStyle.SP_DesktopIcon,
                [
                    ("Reportes", [
                        "Generar gráfica",
                        "Total de alumnos",
                        "Alumnos hombres",
                        "Alumnas mujeres",
                        "Generar archivo PDF",
                    ]),
                ],
            ),
            0, 2,
        )

        for columna in range(3):
            tarjetas.setColumnStretch(columna, 1)

        principal.addLayout(tarjetas)

    def crear_tarjeta_menu(self, titulo, icono_tipo, secciones):
        tarjeta = QFrame()
        tarjeta.setObjectName("tarjetaMenu")
        tarjeta.setStyleSheet("""
            QFrame#tarjetaMenu {
                background-color: #FFFFFF;
                border: 1px solid #D7E2F0;
                border-radius: 22px;
            }
        """)

        contenido = QVBoxLayout(tarjeta)
        contenido.setContentsMargins(18, 18, 18, 18)
        contenido.setSpacing(10)

        encabezado = QHBoxLayout()
        icono = QLabel()
        icono.setPixmap(
            self.style().standardIcon(icono_tipo).pixmap(QSize(24, 24))
        )
        encabezado.addWidget(icono)

        nombre = QLabel(titulo)
        nombre.setStyleSheet("""
            color: #173A70;
            font-size: 15px;
            font-weight: bold;
            background: transparent;
        """)
        encabezado.addWidget(nombre)
        encabezado.addStretch()
        contenido.addLayout(encabezado)

        separador = QFrame()
        separador.setFixedHeight(2)
        separador.setStyleSheet("background-color: #2F6DB2; border: none;")
        contenido.addWidget(separador)

        for nombre_seccion, acciones in secciones:
            etiqueta_seccion = QLabel(nombre_seccion)
            etiqueta_seccion.setStyleSheet("""
                color: #52657D;
                font-size: 11px;
                font-weight: bold;
                background: transparent;
            """)
            contenido.addWidget(etiqueta_seccion)

            for accion in acciones:
                boton = QPushButton(accion)
                boton.setCursor(Qt.PointingHandCursor)
                boton.setMinimumHeight(34)
                boton.setIcon(
                    self.style().standardIcon(QStyle.SP_ArrowForward)
                )
                boton.setIconSize(QSize(14, 14))
                boton.setStyleSheet("""
                    QPushButton {
                        text-align: left;
                        color: #26384D;
                        background-color: #F3F7FC;
                        border: 1px solid #E0E8F2;
                        border-radius: 8px;
                        padding: 5px 9px;
                    }
                    QPushButton:hover {
                        color: #174E91;
                        background-color: #E4EFFB;
                        border: 1px solid #9BBCE0;
                    }
                """)
                boton.clicked.connect(
                    lambda checked=False, texto=accion:
                        self.accion_seleccionada.emit(texto)
                )
                contenido.addWidget(boton)

        contenido.addStretch()
        return tarjeta